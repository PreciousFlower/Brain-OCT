class BasicConv2d(nn.Module):
    def init(self, in_planes, out_planes, kernel_size, stride=1, padding=0, dilation=1):
        super(BasicConv2d, self).init()

        self.conv = nn.Conv2d(in_planes, out_planes,
                              kernel_size=kernel_size, stride=stride,
                              padding=padding, dilation=dilation, bias=False)
        self.bn = nn.BatchNorm2d(out_planes)
        self.relu = nn.ReLU(inplace=True)

    def forward(self, x):
        x = self.conv(x)
        x = self.bn(x)
        return x


import torch
import torch.nn as nn
import torch.nn.functional as F


class RIM(nn.Module):
    """
    利用极坐标 & 频域抑 speckle 的低层增强模块
    """
    def init(self, c_in, radial_k=9):
        super().init()
        # θ 方向的深度可分离卷积
        self.theta_conv = nn.Conv2d(
            c_in, c_in,
            kernel_size=(1, radial_k),
            padding=(0, radial_k // 2),
            groups=c_in,
            bias=False
        )
        # 1×1 卷积（pointwise）
        self.point = nn.Conv2d(c_in, c_in, 1, bias=False)
        # 简易 DCT 通道注意力
        self.freq_fc = nn.Sequential(
            nn.AdaptiveAvgPool2d(1),
            nn.Conv2d(c_in, c_in // 8, 1, bias=False),
            nn.ReLU(True),
            nn.Conv2d(c_in // 8, c_in, 1, bias=False),
            nn.Sigmoid()
        )

    def forward(self, x):
        """
        x: [B, C, H, W]
        """
        B, C, H, W = x.shape

        # 1) 生成 polar grid，假设返回的是 shape=[*, H, W] 的张量
        grid_r, grid_t = make_polar_grid(H, W, x.device)
        # ---- squeeze 掉所有 size==1 的维度，确保剩下 [H, W] ----
        grid_r = grid_r.squeeze()
        grid_t = grid_t.squeeze()

        # 2) stack→[H, W, 2]，再 expand→[B, H, W, 2]
        grid = torch.stack([grid_t, grid_r], dim=-1)    # [H, W, 2]
        grid = grid.unsqueeze(0).expand(B, H, W, 2).contiguous()

        # 3) 极坐标空间采样
        polar = F.grid_sample(
            x, grid,
            mode='bilinear',
            padding_mode='zeros',
            align_corners=True
        )

        # 4) θ 方向深度卷积 + pointwise
        polar = self.point(self.theta_conv(polar))

        # 5) 频域注意力（取 rfft2 → 绝对值 → 平均 → SIGMOID）
        freq = torch.abs(torch.fft.rfft2(polar, norm='ortho'))
        weight = self.freq_fc(freq.mean(dim=(-2, -1), keepdim=True))
        polar = polar * weight

        # 6) 反极坐标采样回 Cartesian
        cart = F.grid_sample(
            polar, grid,
            mode='bilinear',
            padding_mode='zeros',
            align_corners=True
        )

        # 7) 残差连接
        return cart + x


from mmcv.ops import DeformConv2d

class DeformCFM(nn.Module):
    def init(self, channel):
        super().init()
        # 1×1 降通道
        self.reduce_l = nn.Conv2d(channel, channel, kernel_size=1, bias=False)
        self.reduce_m = nn.Conv2d(channel, channel, kernel_size=1, bias=False)
        self.reduce_h = nn.Conv2d(channel, channel, kernel_size=1, bias=False)
        # 用于 deformable conv 的 offset predictor
        self.offset_conv = nn.Conv2d(channel, 18, kernel_size=3, padding=1, bias=False)
        # deform conv
        self.deform_conv = DeformConv2d(
            in_channels=channel, out_channels=channel,
            kernel_size=3, padding=1, bias=False
        )
        # 最后的融合 conv
        self.post = nn.Conv2d(channel * 3, channel, kernel_size=3, padding=1, bias=False)

    def forward(self, h, m, l):
        """
        h: deepest feature (最小空间),  shape=(B, C, H/32, W/32)
        m: middle  feature,            shape=(B, C, H/16, W/16)
        l: low-level feature (largest), shape=(B, C, H/8,  W/8 )
        返回: 融合后的 (B, C, H/8, W/8)
        """
        # 1) 先把 m, h 上采样到 l 的空间大小
        target_size = l.shape[2:]
        m_up = F.interpolate(m, size=target_size, mode='bilinear', align_corners=True)
        h_up = F.interpolate(h, size=target_size, mode='bilinear', align_corners=True)

        # 2) 通道降维
        l_r = self.reduce_l(l)
        m_r = self.reduce_m(m_up)
        h_r = self.reduce_h(h_up)

        # 3) (可选) 在低层上来一次可变形卷积，增强形状对齐能力
        offset = self.offset_conv(l_r)          # shape = (B, 2*kernel*kernel, H/8, W/8)
        l_def = self.deform_conv(l_r, offset)   # shape = (B, C, H/8, W/8)

        # 4) 三路拼接 & 融合
        fusion = torch.cat([l_def, m_r, h_r], dim=1)   # (B, 3C, H/8, W/8)
        out    = self.post(fusion)                    # (B,   C, H/8, W/8)

        return out

class BAM(nn.Module):
    def init(self, in_ch, window=7):
        super().init()
        self.edge_conv = nn.Conv2d(1, in_ch, 3, 1, 1, bias=False)
        self.swin = nn.Sequential(
            nn.Conv2d(in_ch, in_ch, 1),  # 线性 proj 作为 swin 架构的简化
            nn.BatchNorm2d(in_ch), nn.GELU()
        )
        self.proj = nn.Conv2d(in_ch, 1, 1)

    def forward(self, feat, edge_gray):
        edge = F.interpolate(edge_gray, feat.shape[-2:], mode='bilinear', align_corners=True)
        edge = torch.sigmoid(edge)
        q = self.edge_conv(edge) * feat         # 将边缘作为 Query mask
        att = self.swin(q) + feat               # window attention -> 这里用简化实现
        return att, self.proj(att)

def make_polar_grid(H, W, device='cpu'):
    """
    返回 polar 采样用的 (grid_r, grid_t)，shape 都是 (H, W).
    grid_r 对应半径 r 归一化到 [-1,1], grid_t 是角度 θ 归一化到 [-1,1].
    """
    # 中心
    cx, cy = (W - 1) / 2.0, (H - 1) / 2.0

    ys = torch.linspace(0, H - 1, H, device=device)
    xs = torch.linspace(0, W - 1, W, device=device)
    y, x = torch.meshgrid(ys, xs, indexing='ij')

    # 计算 r, θ
    dx = (x - cx)
    dy = (y - cy)
    r  = torch.sqrt(dx*dx + dy*dy)
    theta = torch.atan2(dy, dx)  # [-π, π]

    # 归一化到 grid_sample 要求的 [-1,1]
    r_norm = 2.0 * (r / r.max()) - 1.0
    t_norm = theta / math.pi

    return r_norm.unsqueeze(0).unsqueeze(0), t_norm.unsqueeze(0).unsqueeze(0)

class BrainOCT_PVT(nn.Module):
    def init(self, ch=32):
        super(BrainOCT_PVT, self).init()
        self.backbone = pvt_v2_b2()  # [64, 128, 320, 512]
        path = './pretrained_pth/pvt_v2_b2.pth'
        save_model = torch.load(path)
        model_dict = self.backbone.state_dict()
        state_dict = {k: v for k, v in save_model.items() if k in model_dict.keys()}
        model_dict.update(state_dict)
        self.backbone.load_state_dict(model_dict)
        self.trans2 = BasicConv2d(128, ch, 1)   # p2 是 128
        self.trans3 = BasicConv2d(320, ch, 1)   # p3 是 320
        self.trans4 = BasicConv2d(512, ch, 1)   # p4 是 512

        self.cim = RIM(64)
        self.dcfm = DeformCFM(ch)
        self.bam  = BAM(ch)

        self.pred_cfm = nn.Conv2d(ch, 1, 1)
        self.pred_bam = nn.Conv2d(1, 1, 1)   # bam 已输出 1 通道

    def forward(self, x):
        p1,p2,p3,p4 = self.backbone(x)
        cim_f = self.cim(p1)                 # [B,64,H/4,W/4]
        t2 = self.trans2(p2); t3=self.trans3(p3); t4=self.trans4(p4)
        cfm = self.dcfm(t4,t3,t2)            # [B,ch,H/4,W/4]
        bam_f, bam_edge = self.bam(cfm, cim_f[:,0:1])  # 用低层亮/暗梯度生成 edge

        out1 = F.interpolate(self.pred_cfm(cfm),   scale_factor=8, mode='bilinear')
        out2 = F.interpolate(self.pred_bam(bam_edge), scale_factor=8, mode='bilinear')
        return out1, out2

